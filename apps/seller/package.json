{
  "name": "beautybook-seller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host localhost --port 5175 --strictPort",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host localhost --port 4175",
    "cap:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:add:android": "node ./node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:add:ios": "node ./node_modules/@capacitor/cli/bin/capacitor add ios",
    "cap:open:android": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:open:ios": "node ./node_modules/@capacitor/cli/bin/capacitor open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
